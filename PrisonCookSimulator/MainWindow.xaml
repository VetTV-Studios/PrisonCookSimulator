<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrisonCookSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="#0E1216">
        <Grid.Resources>
            <Style TargetType="Button" x:Key="Gold">
                <Setter Property="Background" Value="#E8A838"/>
                <Setter Property="Foreground" Value="#0E1216"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style TargetType="Button" x:Key="Ghost" BasedOn="{StaticResource Gold}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#EDE6D6"/>
                <Setter Property="BorderBrush" Value="#3A4650"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="Button" x:Key="Station">
                <Setter Property="Background" Value="#243038"/>
                <Setter Property="Foreground" Value="#EDE6D6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,14"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
        </Grid.Resources>

        <Grid x:Name="MenuPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                <TextBlock Text="IRONWOOD C.F." FontSize="13" LetterSpacing="6" Foreground="#7FA18B" HorizontalAlignment="Center"/>
                <TextBlock Text="PRISON COOK" FontSize="42" FontWeight="Bold" Foreground="#EDE6D6" HorizontalAlignment="Center"/>
                <TextBlock Text="SIMULATOR" FontSize="42" FontWeight="Bold" Foreground="#E8A838" HorizontalAlignment="Center" Margin="0,-8,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#9AA7B0" FontSize="14" Margin="0,0,0,20" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="You run the kitchen on a state allotment. Plan the menu, work every station, keep hygiene high enough that the inspector does not shut the line. Eight weeks. Do not starve the count."/>
                <Button Style="{StaticResource Gold}" Content="Kitchen contract  ·  8 weeks" Click="OnContract"/>
                <Button Style="{StaticResource Gold}" Content="Rush line  ·  arcade service" Click="OnRush"/>
                <Button Style="{StaticResource Ghost}" Content="How the line works" Click="OnHelp"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="HelpPanel" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <TextBlock Text="The line" FontSize="28" FontWeight="SemiBold" Foreground="#E8A838"/>
                <TextBlock TextWrapping="Wrap" Foreground="#EDE6D6" Margin="0,12,0,16" FontSize="14"
Text="Contract — eight weeks of breakfast and supper at Ironwood. Buy stores, pick two recipes, then hit the line. Each ticket is a tray. Press stations in order. Early or late hits ding quality. Three ruined trays or a failed inspection can end the contract.&#x0a;&#x0a;Rush — no budget. Just tickets and a clock. Three ruined trays ends the run. Beat your best score.&#x0a;&#x0a;Stations: Prep, Range, Fryer, Steam, Window. Pit is the only way to claw hygiene back mid-service. Trustees boost the station they are best at. The warden tasting and the health inspector do not care about your excuses."/>
                <Button Style="{StaticResource Gold}" Content="Back" Click="OnMenu"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="HubPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Padding="28,22">
                <StackPanel>
                    <TextBlock x:Name="HubTitle" FontSize="26" FontWeight="SemiBold" Foreground="#E8A838"/>
                    <TextBlock x:Name="HubMeta" Foreground="#7FA18B" Margin="0,2,0,12"/>
                    <Border Background="#1C262E" Padding="12" CornerRadius="6" BorderBrush="#2E3A44" BorderThickness="1">
                        <TextBlock x:Name="HubLog" Foreground="#EDE6D6" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                    <Grid Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatBudget" Grid.Column="0" Foreground="#E8A838"/>
                        <TextBlock x:Name="StatHyg" Grid.Column="1" Foreground="#7FA18B"/>
                        <TextBlock x:Name="StatMorale" Grid.Column="2" Foreground="#EDE6D6"/>
                        <TextBlock x:Name="StatFavor" Grid.Column="3" Foreground="#EDE6D6"/>
                    </Grid>
                    <TextBlock Text="TODAY'S MENU" Foreground="#E8A838" FontSize="14" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MenuABtn" Style="{StaticResource Ghost}" Width="200" Click="OnCycleMenuA"/>
                        <Button x:Name="MenuBBtn" Style="{StaticResource Ghost}" Width="200" Click="OnCycleMenuB"/>
                    </StackPanel>
                    <TextBlock Text="CREW" Foreground="#E8A838" FontSize="14" Margin="0,16,0,6"/>
                    <ListView x:Name="CrewList" MaxHeight="140" Background="#141A1F"/>
                    <TextBlock Text="PANTRY" Foreground="#E8A838" FontSize="14" Margin="0,16,0,6"/>
                    <ListView x:Name="PantryList" MaxHeight="160" Background="#141A1F"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Style="{StaticResource Gold}" Content="Open the line" Width="180" Click="OnOpenLine"/>
                        <Button Style="{StaticResource Ghost}" Content="Scrub kitchen  $25" Width="180" Click="OnScrub"/>
                        <Button Style="{StaticResource Ghost}" Content="Menu" Width="100" Click="OnMenu"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#141A1F" Padding="18" BorderBrush="#2E3A44" BorderThickness="1,0,0,0">
                <StackPanel>
                    <TextBlock Text="VENDOR + SHOP" Foreground="#E8A838" FontSize="16" Margin="0,0,0,10"/>
                    <ComboBox x:Name="BuyBox" HorizontalAlignment="Stretch"/>
                    <Button Style="{StaticResource Gold}" Content="Buy one crate" Click="OnBuyCrate"/>
                    <TextBlock Text="Upgrades" Foreground="#7FA18B" Margin="0,16,0,6"/>
                    <ListView x:Name="ShopList" MaxHeight="280" IsItemClickEnabled="True" ItemClick="OnBuyUpgrade"/>
                    <TextBlock x:Name="ShopHint" Foreground="#9AA7B0" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Tap an upgrade to buy it. Allotment posts every Monday."/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="LinePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>
            <Grid Padding="20,12" Background="#141A1F">
                <StackPanel>
                    <TextBlock x:Name="LineHud" Foreground="#E8A838" FontSize="14"/>
                    <TextBlock x:Name="LineStats" Foreground="#EDE6D6" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Style="{StaticResource Ghost}" Content="Pit / scrub" Click="OnPit" Width="120"/>
                    <Button Style="{StaticResource Ghost}" Content="Abandon" Click="OnAbandon" Width="110"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Padding="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#1C262E" CornerRadius="8" Padding="14" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="TICKETS" Foreground="#7FA18B" FontSize="12"/>
                        <TextBlock x:Name="QueueText" Foreground="#EDE6D6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1C262E" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TicketName" FontSize="28" FontWeight="SemiBold" Foreground="#E8A838"/>
                        <TextBlock x:Name="TicketTag" Foreground="#7FA18B" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TicketSteps" Foreground="#EDE6D6" FontSize="16" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="TicketBar" Minimum="0" Maximum="1" Value="1" Height="10" Margin="0,16,0,8" Foreground="#E8A838" Background="#2E3A44"/>
                        <TextBlock x:Name="TicketHint" Foreground="#9AA7B0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Padding="20,0,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Station}" Content="PREP" Click="OnStation" Tag="Prep"/>
                <Button Grid.Column="1" Style="{StaticResource Station}" Content="RANGE" Click="OnStation" Tag="Range"/>
                <Button Grid.Column="2" Style="{StaticResource Station}" Content="FRYER" Click="OnStation" Tag="Fryer"/>
                <Button Grid.Column="3" Style="{StaticResource Station}" Content="STEAM" Click="OnStation" Tag="Steam"/>
                <Button Grid.Column="4" Style="{StaticResource Station}" Content="WINDOW" Click="OnStation" Tag="Window"/>
            </Grid>
            <Grid Grid.Row="3" Padding="20,8" Background="#141A1F">
                <ProgressBar x:Name="ServiceBar" Minimum="0" Maximum="12" Value="0" Height="12" VerticalAlignment="Top" Foreground="#7FA18B" Background="#2E3A44"/>
                <TextBlock x:Name="LineToast" Foreground="#EDE6D6" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>
        </Grid>

        <Grid x:Name="ReportPanel" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                <TextBlock Text="Shift report" FontSize="28" Foreground="#E8A838"/>
                <TextBlock x:Name="ReportBody" TextWrapping="Wrap" Foreground="#EDE6D6" Margin="0,12,0,16" FontSize="15"/>
                <Button Style="{StaticResource Gold}" Content="Back to the kitchen" Click="OnReportDone"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="EndPanel" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                <TextBlock x:Name="EndTitle" FontSize="28" FontWeight="SemiBold" Foreground="#E8A838"/>
                <TextBlock x:Name="EndBody" TextWrapping="Wrap" Foreground="#EDE6D6" Margin="0,12,0,16" FontSize="15"/>
                <Button Style="{StaticResource Gold}" Content="Main menu" Click="OnMenu"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
